# All variables in this file are server-only.
# Do not prefix secrets with NEXT_PUBLIC_ or expose them to client code.

# Database
DATABASE_URL=

# Authentication
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Wallet encryption
# Exactly 32 random bytes encoded as base64. Never log or expose this value.
ARMINT_ENCRYPTION_KEY=
# Optional previous key for zero-downtime rotation (same format). See docs/architecture.md.
# ARMINT_PREVIOUS_ENCRYPTION_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
# Bot username from BotFather, with or without the leading @.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional per-network RPC overrides (public defaults are in lib/networks.ts).
# Values are read only at runtime, and the RPC must report the selected job's chain ID.
# Use testnets for initial testing. Arc uses native USDC (18 decimals); Ink uses ETH.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
INK_SEPOLIA_RPC_URL=https://rpc-gel-sepolia.inkonchain.com
ARC_RPC_URL=https://rpc.mainnet.arc.io
INK_RPC_URL=https://rpc-gel.inkonchain.com
# Optional recovery endpoints for existing Base jobs. New Base jobs are disabled.
# LEGACY_BASE_RPC_URL=https://mainnet.base.org
# LEGACY_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
