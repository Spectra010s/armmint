# All variables in this file are server-only.
# Do not prefix secrets with NEXT_PUBLIC_ or expose them to client code.

# Database
DATABASE_URL=

# Authentication
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Wallet encryption
# Exactly 32 random bytes encoded as base64. Never log or expose this value.
ARMINT_ENCRYPTION_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Blockchain
# Base is the first supported chain. Keep the variable chain-specific so more EVM chains can be added later.
BASE_RPC_URL=https://sepolia.base.org
